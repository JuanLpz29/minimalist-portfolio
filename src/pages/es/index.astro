---
import Layout from "@/layouts/Layout.astro";
import KeyBoardManager from "@/components/KeyBoardManager.astro";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import { Hero, About, Experience, SelectedWork, Skills, Languages, Projects, Contact } from "@/components/sections";

import cv from "@/data/cv.es.json";
import { useTranslations } from "@/i18n/ui";

const lang = "es";
const t = useTranslations(lang);
const { name, label, tagline, summary } = cv.basics;
---

<Layout
	title={`${name} — ${label} · ${tagline}`}
	description={summary}
	lang={lang}
	path="/es/"
>
	<LanguageSwitcher lang={lang} />
	<main>
		<Hero cv={cv} t={t} lang={lang} />
		<Experience cv={cv} t={t} lang={lang} />
		<SelectedWork cv={cv} t={t} />
		<Projects cv={cv} t={t} />
		<Skills cv={cv} t={t} />
		<Languages cv={cv} t={t} />
		<About cv={cv} t={t} />
		<Contact cv={cv} t={t} />
	</main>

	<KeyBoardManager cv={cv} t={t} />
</Layout>

<style>
	main {
		padding: 4rem;
		margin: auto;
		width: 100%;
	}

	@media (width <= 700px) {
		main {
			padding: 2rem;
		}
	}
</style>
