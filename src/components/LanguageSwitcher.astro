---
interface Props {
	lang: "en" | "es";
}

const { lang } = Astro.props;
---

<nav class="lang-switch no-print" aria-label="Language">
	<a href="/" aria-current={lang === "en" ? "page" : undefined}>EN</a>
	<span>/</span>
	<a href="/es/" aria-current={lang === "es" ? "page" : undefined}>ES</a>
</nav>

<style>
	.lang-switch {
		position: fixed;
		top: 16px;
		right: 16px;
		z-index: 10;
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 0.75rem;
		font-weight: 600;
		background: #fff;
		border: 1px solid #eee;
		border-radius: 999px;
		padding: 6px 10px;
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
	}

	.lang-switch span {
		color: #ccc;
	}

	.lang-switch a {
		color: #999;
		transition: color 0.15s ease;
	}

	.lang-switch a[aria-current="page"] {
		color: #111;
	}

	.lang-switch a:not([aria-current="page"]):hover {
		color: #444;
	}

	@media (width <= 700px) {
		.lang-switch {
			top: 10px;
			right: 10px;
		}
	}
</style>
