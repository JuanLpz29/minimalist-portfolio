---
import Section from "../Section.astro";

interface Props {
	cv: any;
	t: any;
}

const { cv, t } = Astro.props;
const { languages } = cv;
---

<Section title={t.languages.title}>
	<ul>
		{
			languages.map(({ name, certificate }: any) => (
				<li>
					{name}
					{certificate && (
						<a href={certificate} target="_blank" rel="noopener noreferrer">
							{t.languages.certificate} ↗
						</a>
					)}
				</li>
			))
		}
	</ul>
</Section>

<style>
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	li {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		background: #f4f4f4;
		color: #222;
		font-size: 0.8rem;
		font-weight: 500;
		padding: 0.3rem 0.75rem;
		border-radius: 6px;
	}

	li a {
		color: #666;
		font-size: 0.7rem;
		font-weight: 600;
		background: #fff;
		border-radius: 4px;
		padding: 2px 6px;
		transition: all 0.15s ease;
	}

	li a:hover {
		background: #111;
		color: #fff;
	}
</style>
