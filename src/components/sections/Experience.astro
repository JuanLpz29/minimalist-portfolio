---
import Section from "../Section.astro";

interface Props {
	cv: any;
	t: any;
	lang: "en" | "es";
}

const { cv, t, lang } = Astro.props;
const { work, earlierExperience } = cv;
const monthYear = (date: string) =>
	new Date(date).toLocaleDateString(lang === "es" ? "es-CL" : "en-US", {
		month: "short",
		year: "numeric",
		timeZone: "UTC",
	});
---

<Section title={t.experience.title}>
	<ul>
		{
			work.map(({ name, startDate, endDate, position, summary, highlights }: any) => (
				<li>
					<article>
						<header>
							<div>
								<h3>{name}</h3>
								<h4>{position}</h4>
							</div>

							<div>
								<time datetime={startDate}>{monthYear(startDate)}</time>
								{" – "}
								<time datetime={endDate ?? ""}>{endDate ? monthYear(endDate) : t.experience.present}</time>
							</div>
						</header>

						<footer>
							<p class="summary">{summary}</p>
							{highlights.map((highlight: string) => (
								<span>{highlight}</span>
							))}
						</footer>
					</article>
				</li>
			))
		}
	</ul>

	<div class="earlier">
		<h4>{t.experience.earlierTitle}</h4>
		<ul class="earlier-list">
			{earlierExperience.map((e: any) => (
				<li>
					<strong>{e.name}</strong> — {e.position} ({e.period})
				</li>
			))}
		</ul>
	</div>
</Section>

<style>
	ul {
		display: flex;
		flex-direction: column;
		gap: 32px;
	}

	article h3 {
		font-weight: 500;
		color: #111;
	}

	article h4 {
		color: #222;
		font-weight: 500;
	}

	header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 4px;
	}

	time {
		color: #555;
		font-size: 0.85rem;
		white-space: nowrap;
	}

	footer .summary {
		text-align: justify;
		text-wrap: pretty;
	}

	footer span {
		margin-top: 10px;
		display: flex;
		flex-direction: column;
		gap: 5px;
		background-color: #f0f0f0;
		padding: 8px;
		border-radius: 4px;
		font-size: 0.7rem;
		line-height: 1.4;
		color: #333;
	}

	.earlier {
		margin-top: 32px;
		border-top: 1px solid #f0f0f0;
		padding-top: 16px;
	}

	.earlier h4 {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: #999;
		font-weight: 600;
		margin-bottom: 8px;
	}

	.earlier-list {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.earlier-list li {
		font-size: 0.8rem;
		color: #666;
		padding-left: 14px;
		position: relative;
	}

	.earlier-list li::before {
		content: "–";
		position: absolute;
		left: 0;
		color: #ccc;
	}

	.earlier strong {
		color: #444;
		font-weight: 600;
	}

	@media (width <= 700px) {
		header {
			flex-direction: column;
			gap: 4px;
		}
	}
</style>
