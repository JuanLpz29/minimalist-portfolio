---
import Section from "../Section.astro";

interface Props {
	cv: any;
	t: any;
}

const { cv, t } = Astro.props;
const { selectedWork } = cv;
---

<Section title={t.selectedWork.title}>
	<ul>
		{
			selectedWork.map(({ name, stack, description }: any) => (
				<li>
					<article>
						<header>
							<h3>{name}</h3>
							<span class="private-badge">{t.selectedWork.privateBadge}</span>
						</header>
						<p>{description}</p>
						<footer>
							{stack.map((tech: string) => (
								<span>{tech}</span>
							))}
						</footer>
					</article>
				</li>
			))
		}
	</ul>
</Section>

<style>
	ul {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1rem;
		margin-inline: -16px;
	}

	article {
		border-radius: 8px;
		border: 1px solid #f2f2f2;
		gap: 12px;
		display: flex;
		flex-direction: column;
		padding: 16px;
		height: 100%;
	}

	article header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
	}

	article h3 {
		font-size: 1rem;
		font-weight: 500;
		color: #111;
	}

	.private-badge {
		font-size: 0.6rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		color: #888;
		background: #f5f5f5;
		border-radius: 6px;
		padding: 2px 8px;
	}

	article p {
		font-size: 0.8rem;
		line-height: 1.3rem;
	}

	footer {
		display: flex;
		flex-wrap: wrap;
		gap: 4px;
		font-size: 0.6rem;
		margin-top: auto;
	}

	footer span {
		border-radius: 6px;
		background: #eee;
		color: #444;
		font-size: 0.6rem;
		font-weight: 500;
		padding: 0.2rem 0.6rem;
	}

	@media (width <= 700px) {
		ul {
			margin-inline: 0px;
			grid-template-columns: 1fr;
		}

		article {
			border: none;
			box-shadow: 0 1px 1px #f2f2f2;
			padding: 0 0 16px 0;
		}
	}
</style>
