---
import Section from "@/components/Section.astro";
import Mail from "@/icons/Mail.astro";
import LinkedIn from "@/icons/LinkedIn.astro";
import GitHub from "@/icons/GitHub.astro";
import WorldMap from "@/icons/WorldMap.astro";
import type { Lang } from "@/i18n/ui";

interface Props {
	cv: any;
	t: any;
	lang: Lang;
}

const { cv, t, lang } = Astro.props;
const { name, label, tagline, pitch, image, location, profiles, email } = cv.basics;
const { city, region } = location;

const linkedUrl = profiles.find((p: any) => p.network === "LinkedIn")?.url;
const githubUrl = profiles.find((p: any) => p.network === "GitHub")?.url;
const resumeHref = cv.cv[lang];
---

<Section>
	<div class="container">
		<div class="info">
			<h1>{name}</h1>
			<h2>{label} <span class="dot">·</span> {tagline}</h2>
			<p class="pitch">{pitch}</p>
			<span class="location">
				<WorldMap />
				{city}, {region}
			</span>

			<div class="ctas no-print">
				<a class="btn btn-primary" href={resumeHref} target="_blank" rel="noopener noreferrer">
					{t.hero.resume}
				</a>
				<a class="btn btn-icon" href={`mailto:${email}`} title="Email">
					<Mail />
				</a>
				<a class="btn btn-icon" href={githubUrl} target="_blank" rel="noopener noreferrer" title="GitHub">
					<GitHub />
				</a>
				<a class="btn btn-icon" href={linkedUrl} target="_blank" rel="noopener noreferrer" title="LinkedIn">
					<LinkedIn />
				</a>
			</div>

			<footer class="print">
				{[email, linkedUrl].filter(Boolean).join(" • ")}
			</footer>
		</div>
		<figure>
			<img src={image} alt={name} />
		</figure>
	</div>
</Section>

<style>
	.container {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.info {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding-right: 32px;
	}

	h1 {
		font-size: 2rem;
	}

	h2 {
		color: #444;
		font-weight: 500;
		font-size: 1.1rem;
		text-wrap: balance;
	}

	h2 .dot {
		color: #ccc;
	}

	.pitch {
		max-width: 46ch;
		text-align: left;
		margin-top: 4px;
	}

	img {
		aspect-ratio: 1 / 1;
		object-fit: cover;
		width: min(256px, 45vw);
		border-radius: 50%;
	}

	.location {
		color: #666;
		display: flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.85rem;
		letter-spacing: -0.05rem;
	}

	.ctas {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		margin-top: 16px;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		font-family: inherit;
		font-size: 0.8rem;
		font-weight: 600;
		border-radius: 8px;
		padding: 10px 16px;
		transition: all 0.15s ease;
		border: 1px solid transparent;
	}

	.btn-primary {
		background: #111;
		color: #fff;
	}

	.btn-primary:hover {
		background: #000;
		transform: translateY(-1px);
		box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
	}

	.btn-ghost {
		background: #fff;
		color: #111;
		border-color: #ddd;
	}

	.btn-ghost:hover {
		border-color: #111;
		transform: translateY(-1px);
	}

	.btn-icon {
		padding: 10px;
		color: #444;
		border-color: #eee;
	}

	.btn-icon:hover {
		border-color: #111;
		color: #111;
	}

	footer {
		color: #555;
		font-size: 0.65rem;
	}

	@media (width <= 700px) {
		.container {
			flex-direction: column-reverse;
		}

		.info {
			justify-content: center;
			align-items: center;
			padding-right: 0;
			text-align: center;
		}

		.pitch {
			text-align: center;
		}

		.ctas {
			justify-content: center;
		}

		figure {
			display: flex;
			justify-content: center;
			align-items: center;
			margin: 0 auto;
		}

		h2 {
			text-wrap: balance;
		}
	}
</style>
