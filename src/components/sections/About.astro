---
import Section from "../Section.astro"

interface Props {
	cv: any
	t: any
}

const { cv, t } = Astro.props
const { summary } = cv.basics
---

<Section title={t.about.title}>
    <p class="justified">
        {summary}
    </p>
</Section>

<style>
    .justified {
        text-align: justify;
    }
</style>
