---
import Section from "../Section.astro";

interface Props {
	cv: any;
	t: any;
}

const { cv, t } = Astro.props;
const { stack } = cv;

const GROUPS = ["languages", "frontend", "backend", "databases", "devops", "tools"] as const;
---

<Section title={t.stack.title}>
	<div class="rows">
		{
			GROUPS.map((group) => (
				<div class="row">
					<h4>{t.stack[group]}</h4>
					<ul>
						{stack[group].map((item: string) => (
							<li>{item}</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
</Section>

<style>
	.rows {
		display: flex;
		flex-direction: column;
	}

	.row {
		display: flex;
		align-items: baseline;
		gap: 24px;
		padding: 12px 0;
		border-bottom: 1px solid #f2f2f2;
	}

	.row:last-child {
		border-bottom: none;
	}

	.row h4 {
		flex: 0 0 110px;
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: #999;
		font-weight: 600;
	}

	.row ul {
		flex: 1;
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.row li {
		background: #f4f4f4;
		color: #222;
		font-size: 0.75rem;
		font-weight: 500;
		padding: 0.25rem 0.65rem;
		border-radius: 6px;
	}

	@media (width <= 700px) {
		.row {
			flex-direction: column;
			align-items: flex-start;
			gap: 8px;
		}

		.row h4 {
			flex: none;
		}
	}
</style>
